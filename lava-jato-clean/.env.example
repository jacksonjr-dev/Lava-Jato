# Variáveis públicas usadas pelo navegador.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_SUBSTITUA_AQUI"

# As mesmas credenciais são usadas no servidor para validar a sessão.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_SUBSTITUA_AQUI"
SUPABASE_SERVICE_ROLE_KEY=SUBSTITUA_PELO_SEU_VALOR

# Segredo exclusivo do servidor para sessões temporárias da área do cliente.
# Gere uma sequência aleatória com pelo menos 32 caracteres e não use VITE_ neste nome.
CLIENT_PORTAL_SECRET=SUBSTITUA_PELO_SEU_VALOR

# Opcional: reconhecimento de placa por imagem.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="SUBSTITUA_PELO_MODELO_OPENAI"

# Opcional: aviso no celular do cliente quando o carro fica pronto (web push).
# Gere o par com: npx web-push generate-vapid-keys
# A chave privada é só do servidor (não use VITE_ nestes nomes). Sem elas, o
# botão "Me avise quando ficar pronto" não aparece.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contato enviado aos serviços de push (mailto: ou endereço do site).
VAPID_SUBJECT="https://seu-dominio.com.br"

# Desenvolvimento local sem serviços externos (opcional).
DEMO_MODE="false"
VITE_DEMO_MODE="false"
